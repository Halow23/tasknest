# =============================================================================
# TaskNest environment variables — copy to .env and fill in
# =============================================================================

# --- Web (Vite, consumed by apps/web) ---------------------------------------
# API origin. Leave unset in dev (Vite proxies /api → localhost:3001);
# set to the deployed API URL (e.g. https://tasknest-api.up.railway.app) in prod.
# VITE_API_URL=

# Firebase web config (Project settings → General → Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=tasknest-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tasknest-dev
VITE_FIREBASE_APP_ID=

# Set to "true" to point the web SDK at local Firebase emulators in dev
# VITE_USE_FIREBASE_EMULATORS=true

# --- API (Node, consumed by apps/api) ----------------------------------------
PORT=3001
# Comma-separated list of allowed CORS origins (the deployed web origin)
ALLOWED_ORIGINS=http://localhost:5173

# Firebase Admin credentials — either the full service-account JSON
# (recommended for Railway/Render) or the three discrete values.
FIREBASE_PROJECT_ID=tasknest-dev
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=tasknest-dev.appspot.com

# Emulators (local dev/tests only): start with `firebase emulators:start`
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9199

# Emails seeded as admins on first sign-in (comma-separated)
ADMIN_EMAILS=

# Secret shared with Cloud Scheduler cron jobs (header: x-cron-secret)
CRON_SECRET=

# Resend transactional email (invites, digest)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Origin used for links inside emails (the deployed web URL)
DIGEST_APP_ORIGIN=http://localhost:5173

# --- Legacy (still required until Phase 3/4 complete the swap) ---------------
DATABASE_URL=
