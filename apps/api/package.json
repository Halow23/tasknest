{
  "name": "@tasknest/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/_core/index.ts",
    "build": "esbuild src/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tasknest/shared": "workspace:*",
    "@trpc/server": "^11.6.0",
    "axios": "^1.12.0",
    "cloudinary": "^2.11.0",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.2",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "jose": "6.1.0",
    "nanoid": "^5.1.5",
    "superjson": "^1.13.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "^24.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.4"
  }
}
